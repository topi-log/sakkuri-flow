{
  "name": "sakkuri-flow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --check public/app.js && node --check public/usability.js && node scripts/check.mjs",
    "build": "npm run check && node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.158.0"
  }
}
